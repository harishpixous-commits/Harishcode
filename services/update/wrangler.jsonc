{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harishcode-update",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "preview_urls": false,
  "pipelines": [
    {
      "binding": "EVENTS",
      // Shared lake stream from harishpixous-commits/platform/production.
      "stream": "251a89241c3a461c9007f6b6f345ed8b",
    },
  ],
  "routes": [
    {
      "pattern": "update.harishcode.ai",
      "custom_domain": true,
    },
    {
      "pattern": "harishcode.ai/update",
      "zone_name": "harishcode.ai",
    },
    {
      "pattern": "harishcode.ai/update/*",
      "zone_name": "harishcode.ai",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harishcode-update",
      "database_id": "2c010a96-811f-43d5-804d-7188534e5858",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
